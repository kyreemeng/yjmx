/* 全宽玻璃导航栏：轻材质，滚动内容从下方透出 */
.nav-root {
  position: relative;
  width: 100%;
}

.nav-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.52) 100%);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  border-bottom: 1rpx solid rgba(120, 90, 60, 0.06);
  box-shadow: none;
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 176rpx;
}

.nav-back {
  position: absolute;
  left: 16rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: transparent;
  border: none;
  transition: transform 100ms ease-out, opacity 100ms ease-out;
}

/* 扩大触控热区到 88×88rpx（44pt），视觉尺寸不变 */
.nav-back::after {
  content: '';
  position: absolute;
  left: -12rpx;
  top: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
}

.nav-back-pressed {
  opacity: 0.45;
  transform: scale(0.9);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #241A15;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  letter-spacing: -0.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .nav-back {
    transition: none;
  }
}
