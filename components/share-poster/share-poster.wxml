<!-- catchtouchmove：拦截触摸滑动；canvas 另加 touch-shield，避免原生层把滑动交给页面 -->
<view
  wx:if="{{visible}}"
  class="poster-modal"
  catchtouchmove="onPreventMove"
  bindtap="onClose"
>
  <view class="poster-wrap" catchtap="preventBubble" catchtouchmove="onPreventMove">
    <view class="poster-title">生成分享卡片</view>
    <view
      class="poster-canvas-wrap"
      style="width: {{previewWidth}}rpx; height: {{previewHeight}}rpx;"
      catchtouchmove="onPreventMove"
    >
      <canvas
        type="2d"
        id="posterCanvas"
        class="poster-canvas"
        style="width: {{previewWidth}}rpx; height: {{previewHeight}}rpx;"
      ></canvas>
      <view class="poster-touch-shield" catchtouchmove="onPreventMove" catchtap="preventBubble"></view>
      <view wx:if="{{generating}}" class="poster-loading">
        <view class="loading-spinner"></view>
        <text>生成卡片中...</text>
      </view>
    </view>

    <view class="poster-actions">
      <view class="poster-btn primary" bindtap="onSave">保存到相册</view>
      <view class="poster-btn" bindtap="onShare">转发给朋友</view>
    </view>

    <view class="poster-close" bindtap="onClose">关闭</view>
  </view>
</view>
