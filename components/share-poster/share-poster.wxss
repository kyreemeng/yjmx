.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 24, 16, 0.72);
  z-index: 110;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 200ms ease;
}

.poster-wrap {
  width: 640rpx;
  max-height: 90vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: slideUp 320ms cubic-bezier(0.22, 1, 0.36, 1);
}

.poster-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C1810;
  margin-bottom: 24rpx;
}

.poster-canvas-wrap {
  position: relative;
  width: 560rpx;
  height: 996rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  background: #FFF8F0;
}

.poster-canvas {
  width: 560rpx;
  height: 996rpx;
  display: block;
}

.poster-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 248, 240, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8B7355;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #F0EDE8;
  border-top-color: #C41E1E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.poster-actions {
  width: 100%;
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  gap: 24rpx;
}

.poster-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: #FFFFFF;
  color: #2C1810;
  border: 1rpx solid #F0EDE8;
}

.poster-btn.primary {
  background: linear-gradient(135deg, #C41E1E, #A01818);
  color: #FFFFFF;
  border: none;
}

.poster-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.poster-close {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #6F6259;
  padding: 16rpx 40rpx;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(48rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .poster-modal,
  .poster-wrap,
  .loading-spinner {
    animation: none;
  }
}
