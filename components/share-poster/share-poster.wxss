.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(70, 48, 36, 0.5);
  backdrop-filter: blur(10rpx) saturate(140%);
  -webkit-backdrop-filter: blur(10rpx) saturate(140%);
  z-index: 110;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 200ms ease;
  /* 覆盖整屏并禁止自身滚动，配合 catchtouchmove 阻断穿透 */
  overflow: hidden;
  overscroll-behavior: none;
  touch-action: none;
}

.poster-wrap {
  width: 640rpx;
  max-height: 90vh;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.72) 100%);
  backdrop-filter: blur(34rpx) saturate(185%);
  -webkit-backdrop-filter: blur(34rpx) saturate(185%);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 36rpx;
  padding: 22rpx 26rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 32rpx 90rpx rgba(70, 48, 36, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  animation: slideUp 320ms cubic-bezier(0.22, 1, 0.36, 1);
}

.poster-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #241A15;
  margin-bottom: 12rpx;
}

.poster-canvas-wrap {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(120, 90, 60, 0.18);
  background: #FBF6EF;
}

.poster-canvas {
  display: block;
}

.poster-touch-shield {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  background: transparent;
}

.poster-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  background: rgba(251, 246, 239, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6E5F55;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(201, 148, 63, 0.2);
  border-top-color: #CF3A32;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.poster-actions {
  width: 100%;
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 14rpx;
}

.poster-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.55) 100%);
  color: #241A15;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
}

.poster-btn.primary {
  background: linear-gradient(135deg, #D8483E, #AD2822);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 10rpx 22rpx rgba(207, 58, 50, 0.28);
}

.poster-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
  transition: transform 100ms ease-out;
}

.poster-close {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #6E5F55;
  padding: 8rpx 40rpx;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(48rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .poster-modal,
  .poster-wrap,
  .loading-spinner {
    animation: none;
  }
}
