.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(12rpx) saturate(140%);
  -webkit-backdrop-filter: blur(12rpx) saturate(140%);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 0 calc(24rpx + env(safe-area-inset-bottom));
  animation: fadeIn 200ms ease;
}

.login-dialog {
  width: 100%;
  max-width: 690rpx;
  margin: 0 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 255, 255, 0.86) 100%);
  backdrop-filter: blur(40rpx) saturate(185%);
  -webkit-backdrop-filter: blur(40rpx) saturate(185%);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  padding: 40rpx 36rpx 28rpx;
  text-align: center;
  box-shadow:
    0 20rpx 60rpx rgba(0, 0, 0, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  animation: slideUp 320ms cubic-bezier(0.22, 1, 0.36, 1);
}

.login-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #241A15;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #6E5F55;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.avatar-picker {
  width: 176rpx;
  min-height: 188rpx;
  padding: 0;
  margin: 0 auto 28rpx;
  background: transparent;
  border: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-picker::after {
  border: none;
}

.avatar-preview {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 28rpx rgba(120, 90, 60, 0.2);
}

.avatar-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #6E5F55;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.6);
  color: #241A15;
  font-size: 30rpx;
  text-align: left;
}

.login-btn {
  background: linear-gradient(135deg, #D8483E, #AD2822);
  color: #FFFFFF;
  border-radius: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 6rpx 16rpx rgba(207, 58, 50, 0.22);
  margin-bottom: 16rpx;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.94;
}

.login-cancel {
  font-size: 28rpx;
  color: #6E5F55;
  padding: 24rpx 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(48rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .login-modal,
  .login-dialog {
    animation: none;
  }
}