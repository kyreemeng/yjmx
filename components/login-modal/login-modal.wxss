.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 24, 16, 0.46);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 200ms ease;
}

.login-dialog {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 24rpx 72rpx rgba(44, 24, 16, 0.18);
  animation: slideUp 320ms cubic-bezier(0.22, 1, 0.36, 1);
}

.login-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C1810;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #8B7355;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.avatar-picker {
  width: 176rpx;
  min-height: 188rpx;
  padding: 0;
  margin: 0 auto 28rpx;
  background: transparent;
  border: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-picker::after {
  border: none;
}

.avatar-preview {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #FFF8F0;
  box-shadow: 0 8rpx 24rpx rgba(83, 48, 30, 0.12);
}

.avatar-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #8B7355;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid #DED5CC;
  border-radius: 16rpx;
  background: #FFFCF8;
  color: #2C1810;
  font-size: 30rpx;
  text-align: left;
}

.login-btn {
  background: linear-gradient(135deg, #C41E1E, #A01818);
  color: #FFFFFF;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  margin-bottom: 24rpx;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.login-cancel {
  font-size: 28rpx;
  color: #6F6259;
  padding: 16rpx 0;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(48rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .login-modal,
  .login-dialog {
    animation: none;
  }
}
