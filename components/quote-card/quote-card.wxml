<!-- 点赞数缩写格式化：≥10000 显示 X万，避免操作栏数字溢出 -->
<wxs module="fmt">
var num = function (n) {
  n = n || 0;
  if (n >= 10000) {
    var v = (n / 10000).toFixed(1);
    if (v.indexOf('.0') >= 0) v = v.slice(0, v.length - 2);
    return v + '万';
  }
  return String(n);
};
module.exports = { num: num };
</wxs>

<view class="quote-card-wrap">
  <view class="quote-card {{animate && (loading || !contentReady) ? 'is-leaving' : 'is-ready'}}" bindtap="onTapCard">
    <view class="quote-content">
      <text class="quote-text">{{quote.content || ''}}</text>
    </view>
    <view class="quote-source">
      <text class="source-line">{{quote.source || '《毛选摘录》'}}</text>
    </view>
  </view>

  <view wx:if="{{showActions}}" class="action-bar {{loading ? 'is-disabled' : ''}}">
    <view wx:if="{{showRefresh}}" class="action-btn refresh" catchtap="onRefresh" hover-class="action-hover">
      <view class="action-icon {{animating && lastAction === 'refresh' ? 'animate-pop' : ''}}">
        <app-icon name="refresh" color="#8A7564" size="{{48}}"></app-icon>
      </view>
      <text class="action-label">换一句</text>
    </view>

    <view class="action-btn like {{liked ? 'active' : ''}}" catchtap="onLike" hover-class="action-hover">
      <view class="action-icon {{animating && lastAction === 'like' ? 'animate-pop' : ''}}">
        <app-icon name="heart" color="{{liked ? '#CF3A32' : '#8A7564'}}" size="{{48}}" filled="{{liked}}"></app-icon>
      </view>
      <text class="action-label">{{liked ? '已赞' : '点赞'}} {{fmt.num(quote.stat.total || 0)}}</text>
    </view>

    <view class="action-btn favorite {{favorited ? 'active' : ''}}" catchtap="onFavorite" hover-class="action-hover">
      <view class="action-icon {{animating && lastAction === 'favorite' ? 'animate-pop' : ''}}">
        <app-icon name="star" color="{{favorited ? '#A5762C' : '#8A7564'}}" size="{{48}}" filled="{{favorited}}"></app-icon>
      </view>
      <text class="action-label">{{favorited ? '已收藏' : '收藏'}}</text>
    </view>

    <button class="action-btn share share-btn" open-type="share" hover-class="action-hover">
      <view class="action-icon">
        <app-icon name="share" color="#8A7564" size="{{48}}"></app-icon>
      </view>
      <text class="action-label">转发</text>
    </button>

    <view class="action-btn poster" catchtap="onPoster" hover-class="action-hover">
      <view class="action-icon {{animating && lastAction === 'poster' ? 'animate-pop' : ''}}">
        <app-icon name="poster" color="#8A7564" size="{{48}}"></app-icon>
      </view>
      <text class="action-label">海报</text>
    </view>
  </view>
</view>
