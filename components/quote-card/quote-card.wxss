.quote-card-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quote-card {
  width: 690rpx;
  min-height: 480rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 250, 244, 0.74) 100%);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  padding: 56rpx 44rpx;
  margin: 40rpx auto 0;
  box-shadow:
    0 14rpx 40rpx rgba(120, 90, 60, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  opacity: 1;
  transform: translateY(0);
  transition: opacity 280ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
}

.quote-card::before {
  content: '“';
  position: absolute;
  top: 16rpx;
  left: 28rpx;
  font-size: 72rpx;
  color: #C9943F;
  opacity: 0.16;
  font-family: Georgia, serif;
  line-height: 1;
}

.quote-content {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 40rpx 0;
}

.quote-text {
  font-size: 36rpx;
  line-height: 1.65;
  font-weight: 600;
  color: #241A15;
  text-align: left;
  font-family: 'Noto Serif CJK SC', 'Songti SC', 'PingFang SC', serif;
  letter-spacing: 2rpx;
}

.quote-source {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.source-line {
  font-size: 25rpx;
  color: #6E5F55;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.action-bar {
  width: 690rpx;
  margin-top: 40rpx;
  padding: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.6) 100%);
  backdrop-filter: blur(28rpx) saturate(175%);
  -webkit-backdrop-filter: blur(28rpx) saturate(175%);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 40rpx;
  box-shadow: 0 18rpx 50rpx rgba(120, 90, 60, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  transition: opacity 180ms ease;
}

.action-bar.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 94rpx;
  padding: 10rpx 4rpx;
  border-radius: 28rpx;
  transition: transform 160ms ease, background-color 160ms ease, opacity 160ms ease;
}

button.share-btn {
  margin: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button.share-btn::after {
  border: none;
}

.action-hover {
  transform: scale(0.94);
  opacity: 0.8;
  background: rgba(207, 58, 50, 0.06);
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  transform-origin: center;
}

.action-label {
  font-size: 24rpx;
  color: #6E5F55;
  line-height: 32rpx;
  white-space: nowrap;
  font-weight: 500;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-btn.like.active .action-label {
  color: #CF3A32;
  font-weight: 700;
}

.action-btn.favorite.active .action-label {
  color: #8C6A1F;
  font-weight: 700;
}

.quote-card.is-leaving {
  opacity: 0;
  transform: translateY(16rpx);
}

@keyframes scalePop {
  0% { transform: scale(1); }
  45% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.action-icon.animate-pop {
  animation: scalePop 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@media (prefers-reduced-motion: reduce) {
  .quote-card,
  .action-btn {
    transition: none;
  }

  .action-icon.animate-pop {
    animation: none;
  }
}