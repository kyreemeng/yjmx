.quote-card-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quote-card {
  width: 690rpx;
  min-height: 480rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(196, 30, 30, 0.07);
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  margin: 40rpx auto 0;
  box-shadow: 0 18rpx 54rpx rgba(83, 48, 30, 0.09);
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  opacity: 1;
  transform: translateY(0);
  transition: opacity 280ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
}

.quote-card::before {
  content: '“';
  position: absolute;
  top: 20rpx;
  left: 28rpx;
  font-size: 92rpx;
  color: #D4A853;
  opacity: 0.2;
  font-family: Georgia, serif;
  line-height: 1;
}

.quote-content {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 40rpx 0;
}

.quote-text {
  font-size: 40rpx;
  line-height: 1.72;
  font-weight: 600;
  color: #2C1810;
  text-align: left;
  font-family: 'Noto Serif CJK SC', 'Songti SC', 'PingFang SC', serif;
  letter-spacing: 1rpx;
}

.quote-source {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.source-line {
  font-size: 25rpx;
  color: #8B7355;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.action-bar {
  width: 690rpx;
  margin-top: 40rpx;
  padding: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(139, 115, 85, 0.12);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(83, 48, 30, 0.06);
  transition: opacity 180ms ease;
}

.action-bar.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  min-height: 94rpx;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  transition: transform 160ms ease, background-color 160ms ease, opacity 160ms ease;
}

.action-hover {
  transform: scale(0.95);
  opacity: 0.85;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  transform-origin: center;
}

.action-label {
  font-size: 22rpx;
  color: #6F6259;
  line-height: 32rpx;
  white-space: nowrap;
}

.action-btn.like.active .action-label {
  color: #C41E1E;
}

.action-btn.favorite.active .action-label {
  color: #D4A853;
}

.quote-card.is-leaving {
  opacity: 0;
  transform: translateY(16rpx);
}

@keyframes scalePop {
  0% { transform: scale(1); }
  45% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.action-icon.animate-pop {
  animation: scalePop 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@media (prefers-reduced-motion: reduce) {
  .quote-card,
  .action-btn {
    transition: none;
  }

  .action-icon.animate-pop {
    animation: none;
  }
}
