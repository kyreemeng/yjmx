.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: rgba(28, 14, 8, 0.96);
  border-top: 1rpx solid rgba(183, 132, 40, 0.24);
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.22);
  z-index: 20;
}

.tab-bar-wrap {
  display: flex;
  height: 100rpx;
  align-items: center;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  transition: transform 180ms ease, opacity 180ms ease;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 22rpx;
  line-height: 30rpx;
  color: rgba(245, 235, 216, 0.52);
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
  color: #E6BE66;
  font-weight: 600;
}

.tab-item:active {
  transform: scale(0.96);
  opacity: 0.82;
}
