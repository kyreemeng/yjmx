.container {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% -10%, rgba(196, 30, 30, 0.14), transparent 38%),
    linear-gradient(165deg, #1A0F08 0%, #2C1810 55%, #0D0703 100%);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.rank-header {
  padding: 42rpx 42rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.rank-seal {
  width: 74rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #C41E1E, #7E1111);
  border: 2rpx solid rgba(245, 235, 216, 0.72);
  border-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  transform: rotate(-4deg);
}

.rank-seal text {
  color: #F5EBD8;
  font-size: 32rpx;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  font-weight: 700;
}

.rank-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #F5EBD8;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  letter-spacing: 3rpx;
}

.rank-subtitle {
  display: block;
  margin-top: 8rpx;
  color: rgba(245, 235, 216, 0.54);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.tab-bar {
  display: flex;
  background: rgba(245, 235, 216, 0.07);
  padding: 0 60rpx;
  border-bottom: 1rpx solid rgba(183, 132, 40, 0.2);
  border-top: 1rpx solid rgba(183, 132, 40, 0.12);
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-label {
  font-size: 30rpx;
  color: rgba(245, 235, 216, 0.52);
  font-weight: 400;
}

.tab-item.active .tab-label {
  color: #F5EBD8;
  font-weight: 700;
}

.tab-indicator {
  width: 48rpx;
  height: 6rpx;
  background: #C41E1E;
  border-radius: 3rpx;
}

.tab-indicator-track {
  position: absolute;
  left: 60rpx;
  bottom: 0;
  width: calc((100% - 120rpx) / 3);
  display: flex;
  justify-content: center;
  transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.rank-swiper {
  flex: 1;
  min-height: 0;
}

.rank-scroll {
  height: 100%;
}

.rank-list {
  padding: 0 32rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(183, 132, 40, 0.28);
  border-radius: 12rpx;
  background: linear-gradient(135deg, rgba(245, 235, 216, 0.98), rgba(234, 220, 195, 0.98));
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  transition: transform 160ms ease, background-color 160ms ease;
}

.rank-number {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #80634F;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-number.top {
  color: #FFFFFF;
  border-radius: 50%;
  background: #B78428;
}

.rank-number.top-2 {
  background: #8B7C70;
}

.rank-number.top-3 {
  background: #A66A45;
}

.rank-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.rank-quote {
  font-size: 32rpx;
  color: #2A170E;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  font-weight: 500;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.rank-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rank-source {
  font-size: 24rpx;
  color: #7A5139;
}

.rank-count {
  font-size: 24rpx;
  color: #856A56;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rank-favorite {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  color: #6F6259;
}

.rank-favorite.active {
  color: #D4A853;
}

.rank-item-pressed {
  background: #F5EBD8;
  transform: translateY(2rpx) scale(0.99);
}

.rank-favorite-pressed {
  transform: scale(0.88);
}

/* 骨架屏 */
.skeleton-list {
  padding: 0 32rpx;
}

.skeleton-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  margin-top: 18rpx;
  padding: 26rpx 24rpx;
  background: rgba(245, 235, 216, 0.08);
  border: 1rpx solid rgba(183, 132, 40, 0.16);
  border-radius: 12rpx;
}

.skeleton-rank {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(245, 235, 216, 0.12);
  margin-right: 24rpx;
}

.skeleton-content {
  flex: 1;
}

.skeleton-text {
  width: 70%;
  height: 36rpx;
  background: rgba(245, 235, 216, 0.12);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-sub {
  width: 40%;
  height: 24rpx;
  background: rgba(245, 235, 216, 0.08);
  border-radius: 8rpx;
}

@media (prefers-reduced-motion: reduce) {
  .tab-indicator-track,
  .rank-item {
    transition: none;
  }
}
