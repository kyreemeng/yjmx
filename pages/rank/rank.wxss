.container {
  min-height: 100vh;
  background: #FAFAFA;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.rank-header {
  padding: 40rpx 0 24rpx;
  background: #FFF8F0;
  text-align: center;
}

.rank-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C1810;
}

.tab-bar {
  display: flex;
  background: #FFF8F0;
  padding: 0 60rpx;
  border-bottom: 1rpx solid #F0EDE8;
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-label {
  font-size: 30rpx;
  color: #6F6259;
  font-weight: 400;
}

.tab-item.active .tab-label {
  color: #2C1810;
  font-weight: 700;
}

.tab-indicator {
  width: 48rpx;
  height: 6rpx;
  background: #C41E1E;
  border-radius: 3rpx;
}

.tab-indicator-track {
  position: absolute;
  left: 60rpx;
  bottom: 0;
  width: calc((100% - 120rpx) / 3);
  display: flex;
  justify-content: center;
  transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.rank-swiper {
  flex: 1;
  min-height: 0;
}

.rank-scroll {
  height: 100%;
}

.rank-list {
  padding: 0 32rpx;
  background: #FAFAFA;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0EDE8;
  background: #FAFAFA;
  transition: transform 160ms ease, background-color 160ms ease;
}

.rank-number {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #6F6259;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-number.top {
  color: #FFFFFF;
  border-radius: 50%;
  background: #B78428;
}

.rank-number.top-2 {
  background: #8B7C70;
}

.rank-number.top-3 {
  background: #A66A45;
}

.rank-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.rank-quote {
  font-size: 32rpx;
  color: #2C1810;
  font-weight: 500;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.rank-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rank-source {
  font-size: 24rpx;
  color: #8B7355;
}

.rank-count {
  font-size: 24rpx;
  color: #6F6259;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rank-favorite {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  color: #6F6259;
}

.rank-favorite.active {
  color: #D4A853;
}

.rank-item-pressed {
  background: #FFF8F0;
  transform: scale(0.995);
}

.rank-favorite-pressed {
  transform: scale(0.88);
}

/* 骨架屏 */
.skeleton-list {
  padding: 0 32rpx;
}

.skeleton-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0EDE8;
}

.skeleton-rank {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F0EDE8;
  margin-right: 24rpx;
}

.skeleton-content {
  flex: 1;
}

.skeleton-text {
  width: 70%;
  height: 36rpx;
  background: #F0EDE8;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-sub {
  width: 40%;
  height: 24rpx;
  background: #F0EDE8;
  border-radius: 8rpx;
}

@media (prefers-reduced-motion: reduce) {
  .tab-indicator-track,
  .rank-item {
    transition: none;
  }
}
