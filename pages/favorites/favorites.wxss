.container {
  min-height: 100vh;
  background: var(--aurora-bg);
  color: #2A1E18;
  padding: 24rpx 0 calc(60rpx + env(safe-area-inset-bottom));
}

.page-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 40rpx 28rpx;
}

.hero-seal {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  background: linear-gradient(135deg, #D8483E, #AD2822);
  box-shadow: 0 6rpx 16rpx rgba(207, 58, 50, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.hero-seal text {
  color: #FFF9F4;
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
}

.page-title,
.page-subtitle {
  display: block;
}

.collection-summary {
  min-height: 112rpx;
  margin: 0 32rpx 18rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.summary-label,
.summary-value {
  display: block;
  font-size: 24rpx;
  color: #6E5F55;
}

.summary-value {
  margin-top: 4rpx;
  font-size: 30rpx;
  color: #241A15;
  font-weight: 700;
}

.summary-percent {
  font-size: 34rpx;
  color: #AD2822;
  font-weight: 700;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.rarity-filter {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.filter-chip {
  min-height: 88rpx;
  padding: 0 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 24rpx;
  color: #5F5148;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
}

.filter-chip.active {
  color: #FFF9F4;
  background: #AD2822;
  border-color: #AD2822;
}

.page-title {
  color: #241A15;
  font-size: 34rpx;
  line-height: 1.2;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-weight: 700;
  letter-spacing: -0.4rpx;
}

.page-subtitle {
  margin-top: 6rpx;
  color: #7A6A5C;
  font-size: 24rpx;
  letter-spacing: 0;
  line-height: 1.35;
}

.skeleton-list {
  margin: 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

.skeleton-item {
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(140, 118, 96, 0.1);
}

.skeleton-item:last-child {
  border-bottom: none;
}

.skeleton-text {
  width: 100%;
  height: 36rpx;
  background: rgba(160, 130, 105, 0.12);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-sub {
  width: 40%;
  height: 24rpx;
  background: rgba(160, 130, 105, 0.08);
  border-radius: 8rpx;
}

/* iOS inset grouped list：一组连续行，非散落卡片 */
.list {
  margin: 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.68) 100%);
  backdrop-filter: blur(28rpx) saturate(170%);
  -webkit-backdrop-filter: blur(28rpx) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 28rpx rgba(120, 90, 60, 0.1), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.list-item {
  padding: 28rpx 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(140, 118, 96, 0.1);
  background: transparent;
  transition: background-color 100ms ease-out;
}

.list-item:last-child {
  border-bottom: none;
}

.item-quote {
  font-size: 30rpx;
  color: #241A15;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  line-height: 1.55;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-source {
  font-size: 24rpx;
  color: #6E5F55;
  max-width: 72%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  font-size: 24rpx;
  color: #7A6A5C;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(140, 118, 96, 0.08);
}

.item-action {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  border-radius: 14rpx;
  color: #6E5F55;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(140, 118, 96, 0.06);
  transition: transform 100ms ease-out, background-color 100ms ease-out, color 100ms ease-out;
}

.item-action.active {
  background: rgba(201, 148, 63, 0.12);
}

.item-action.like-action.active {
  background: rgba(207, 58, 50, 0.1);
  color: #AD2822;
}

.item-action.favorite-action.active {
  color: #8C6A1F;
}

.item-action-pressed {
  transform: scale(0.96);
  background: rgba(140, 118, 96, 0.12);
}

@media (prefers-reduced-motion: reduce) {
  .list-item,
  .item-action {
    transition: none;
  }
}
