.container {
  min-height: 100vh;
  background: #FAFAFA;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.skeleton-list {
  padding: 0 32rpx;
}

.skeleton-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.skeleton-text {
  width: 100%;
  height: 36rpx;
  background: #F0EDE8;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-sub {
  width: 40%;
  height: 24rpx;
  background: #F0EDE8;
  border-radius: 8rpx;
}

.list {
  padding: 0 32rpx;
}

.list-item {
  background: #FFFFFF;
  border: 1rpx solid rgba(139, 115, 85, 0.1);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(83, 48, 30, 0.05);
  transition: transform 160ms ease, background-color 160ms ease;
}

.item-quote {
  font-size: 32rpx;
  color: #2C1810;
  line-height: 1.6;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-source {
  font-size: 24rpx;
  color: #8B7355;
  max-width: 72%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  font-size: 24rpx;
  color: #6F6259;
}

.list-item-pressed {
  background: #FFF8F0;
  transform: scale(0.99);
}

@media (prefers-reduced-motion: reduce) {
  .list-item {
    transition: none;
  }
}
