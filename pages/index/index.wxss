/* ============ 容器 & 背景 ============ */
.container {
  min-height: 100vh;
  background: 
    radial-gradient(ellipse at 50% 15%, rgba(196, 30, 30, 0.08) 0%, transparent 55%),
    radial-gradient(ellipse at 80% 80%, rgba(183, 132, 40, 0.06) 0%, transparent 50%),
    linear-gradient(165deg, #1A0F08 0%, #2C1810 30%, #1A0F08 60%, #0D0703 100%);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* 背景网格纹理 */
.container::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: 
    repeating-linear-gradient(45deg, transparent, transparent 60rpx, rgba(183, 132, 40, 0.02) 60rpx, rgba(183, 132, 40, 0.02) 61rpx),
    repeating-linear-gradient(-45deg, transparent, transparent 60rpx, rgba(196, 30, 30, 0.015) 60rpx, rgba(196, 30, 30, 0.015) 61rpx);
  pointer-events: none;
  z-index: 0;
}

/* ============ 背景粒子 ============ */
.bg-particles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #B78428;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 8rpx rgba(183, 132, 40, 0.6);
}

.particle-0 { left: 15%; top: 30%; animation: particleFloat 1.2s ease-out forwards; }
.particle-1 { left: 30%; top: 25%; animation: particleFloat 1.5s ease-out forwards; }
.particle-2 { left: 50%; top: 20%; animation: particleFloat 1.3s ease-out forwards; }
.particle-3 { left: 70%; top: 25%; animation: particleFloat 1.6s ease-out forwards; }
.particle-4 { left: 85%; top: 30%; animation: particleFloat 1.2s ease-out forwards; }
.particle-5 { left: 20%; top: 45%; animation: particleFloat 1.4s ease-out forwards; }
.particle-6 { left: 40%; top: 40%; animation: particleFloat 1.7s ease-out forwards; }
.particle-7 { left: 60%; top: 40%; animation: particleFloat 1.3s ease-out forwards; }
.particle-8 { left: 80%; top: 45%; animation: particleFloat 1.5s ease-out forwards; }
.particle-9 { left: 25%; top: 60%; animation: particleFloat 1.2s ease-out forwards; }
.particle-10 { left: 55%; top: 55%; animation: particleFloat 1.6s ease-out forwards; }
.particle-11 { left: 75%; top: 60%; animation: particleFloat 1.4s ease-out forwards; }

@keyframes particleFloat {
  0% { opacity: 0; transform: translateY(0) scale(0); }
  20% { opacity: 1; transform: translateY(-20rpx) scale(1); }
  100% { opacity: 0; transform: translateY(-120rpx) scale(0.3); }
}

/* ============ 品牌区 ============ */
.brand-area {
  padding-top: 70rpx;
  padding-bottom: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}

.brand-stamp {
  width: 68rpx;
  height: 68rpx;
  background: linear-gradient(135deg, #C41E1E 0%, #A01818 100%);
  color: #F5EBD8;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  margin-bottom: 18rpx;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  box-shadow: 
    0 4rpx 16rpx rgba(196, 30, 30, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  transform: rotate(-3deg);
  letter-spacing: 2rpx;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #F5EBD8;
  letter-spacing: 12rpx;
  margin-bottom: 14rpx;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  text-shadow: 0 2rpx 8rpx rgba(196, 30, 30, 0.2);
}

.brand-divider {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.divider-line {
  width: 50rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #B78428, transparent);
}

.divider-dot {
  width: 6rpx;
  height: 6rpx;
  background: #B78428;
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(183, 132, 40, 0.5);
}

.brand-slogan {
  font-size: 22rpx;
  color: rgba(245, 235, 216, 0.5);
  letter-spacing: 4rpx;
  font-weight: 400;
}

/* ============ 盲盒区 ============ */
.box-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
  padding-top: 30rpx;
  min-height: 600rpx;
}

.box-area.state-opening,
.box-area.state-revealed {
  min-height: 800rpx;
  padding-top: 0;
}

/* ---- 盲盒 ---- */
.box-wrap {
  width: 320rpx;
  height: 320rpx;
  position: relative;
  transition: transform 200ms ease;
}

.box-area.state-opening .box-wrap,
.box-area.state-revealed .box-wrap {
  transform: translateY(-54rpx) scale(0.72);
  opacity: 0.36;
  pointer-events: none;
  transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1), opacity 360ms ease;
}

.box-wrap:active {
  transform: scale(0.96);
}

.box-wrap.is-shaking {
  animation: boxShake 500ms ease-in-out;
}

@keyframes boxShake {
  0%, 100% { transform: rotate(0) translateX(0); }
  15% { transform: rotate(-4deg) translateX(-8rpx); }
  30% { transform: rotate(4deg) translateX(8rpx); }
  45% { transform: rotate(-3deg) translateX(-6rpx); }
  60% { transform: rotate(3deg) translateX(6rpx); }
  75% { transform: rotate(-2deg) translateX(-3rpx); }
  90% { transform: rotate(1deg) translateX(2rpx); }
}

/* 盒盖 */
.box-lid {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 90rpx;
  z-index: 5;
  transition: transform 800ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 600ms ease 400ms;
}

.box-lid.lid-fly {
  animation: lidPop 800ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes lidPop {
  0% { transform: translateX(-50%) translateY(0) rotate(0deg); }
  30% { transform: translateX(-50%) translateY(-60rpx) rotate(-8deg); }
  100% { transform: translateX(-50%) translateY(-180rpx) rotate(-25deg); opacity: 0; }
}

.lid-top {
  width: 100%;
  height: 70rpx;
  background: linear-gradient(180deg, #C41E1E 0%, #A01818 50%, #8B0000 100%);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  box-shadow: 
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2),
    inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.3),
    0 6rpx 20rpx rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.lid-stamp {
  width: 44rpx;
  height: 44rpx;
  background: rgba(245, 235, 216, 0.15);
  border: 2rpx solid rgba(245, 235, 216, 0.4);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lid-stamp-text {
  font-size: 18rpx;
  color: rgba(245, 235, 216, 0.8);
  font-weight: 800;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  white-space: pre;
  text-align: center;
  line-height: 1.2;
}

.lid-edge {
  width: 100%;
  height: 8rpx;
  background: linear-gradient(180deg, #8B0000, #5C0000);
  border-radius: 0 0 4rpx 4rpx;
}

/* 封蜡 */
.wax-seal {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 52rpx;
  height: 52rpx;
  background: radial-gradient(circle at 35% 30%, #E83030 0%, #C41E1E 40%, #8B0000 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 4rpx 12rpx rgba(196, 30, 30, 0.5),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.wax-seal-text {
  font-size: 22rpx;
  color: #F5EBD8;
  font-weight: 800;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
}

/* 盒身 */
.box-body {
  position: absolute;
  top: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 290rpx;
  height: 230rpx;
  background: linear-gradient(180deg, #2C1810 0%, #1A0F08 50%, #0D0703 100%);
  border-radius: 6rpx;
  box-shadow: 
    inset 0 4rpx 0 rgba(183, 132, 40, 0.1),
    0 12rpx 40rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
}

.box-inner {
  position: absolute;
  top: 0;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  background: radial-gradient(ellipse at 50% 0%, rgba(183, 132, 40, 0.15) 0%, transparent 60%);
  border-radius: 4rpx;
  overflow: hidden;
}

/* 盒内光效 */
.box-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 215, 100, 0.6) 0%, rgba(183, 132, 40, 0.3) 40%, transparent 70%);
  border-radius: 50%;
  animation: glowPulse 600ms ease-out;
}

@keyframes glowPulse {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  40% { opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(2); opacity: 0; }
}

.box-shadow-inner {
  position: absolute;
  inset: 0;
  box-shadow: inset 0 8rpx 20rpx rgba(0, 0, 0, 0.6);
  border-radius: 4rpx;
}

/* 盒身侧纹 */
.box-side-pattern {
  position: absolute;
  top: 20rpx;
  left: 8rpx;
  bottom: 20rpx;
  width: 4rpx;
  background: linear-gradient(180deg, transparent, rgba(183, 132, 40, 0.3), transparent);
}

.box-label {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
}

.box-label-text {
  font-size: 16rpx;
  color: rgba(183, 132, 40, 0.4);
  letter-spacing: 3rpx;
  font-weight: 600;
}

/* 盒底 */
.box-base {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 12rpx;
  background: linear-gradient(180deg, #1A0F08, #0D0703);
  border-radius: 0 0 8rpx 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

/* 待拆提示 */
.box-hint {
  position: absolute;
  bottom: -50rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  white-space: nowrap;
  z-index: 5;
}

.hint-dot {
  width: 6rpx;
  height: 6rpx;
  background: #B78428;
  border-radius: 50%;
  animation: dotBlink 1.5s ease-in-out infinite;
}

.box-hint-text {
  font-size: 24rpx;
  color: rgba(245, 235, 216, 0.6);
  letter-spacing: 3rpx;
  font-weight: 500;
}

@keyframes dotBlink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; box-shadow: 0 0 6rpx rgba(183, 132, 40, 0.6); }
}

/* ============ 光柱 ============ */
.light-beam {
  position: absolute;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 500rpx;
  background: linear-gradient(180deg, 
    rgba(255, 215, 100, 0.4) 0%, 
    rgba(183, 132, 40, 0.2) 30%, 
    transparent 100%);
  clip-path: polygon(40% 0%, 60% 0%, 90% 100%, 10% 100%);
  z-index: 3;
  animation: beamGrow 600ms ease-out;
}

.light-beam.beam-fade {
  animation: beamFade 800ms ease-out forwards;
}

@keyframes beamGrow {
  0% { opacity: 0; transform: translateX(-50%) scaleY(0); transform-origin: top; }
  100% { opacity: 1; transform: translateX(-50%) scaleY(1); transform-origin: top; }
}

@keyframes beamFade {
  0% { opacity: 1; }
  100% { opacity: 0; }
}

/* ============ 卡牌舞台 ============ */
.card-stage {
  width: 100%;
  display: flex;
  justify-content: center;
  position: relative;
  z-index: 4;
  margin-top: 20rpx;
  perspective: 1500rpx;
}

.box-area.state-opening .card-stage,
.box-area.state-revealed .card-stage {
  position: absolute;
  top: 28rpx;
  left: 0;
  margin-top: 0;
}

.card-stage.card-rising {
  animation: cardRise 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.card-stage.card-up {
  animation: cardFloat 3s ease-in-out 700ms infinite;
}

@keyframes cardRise {
  0% {
    opacity: 0;
    transform: translateY(120rpx) scale(0.6);
  }
  60% {
    opacity: 1;
    transform: translateY(-10rpx) scale(1.05);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes cardFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* 3D 翻转容器 */
.card-3d {
  width: 560rpx;
  height: 720rpx;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 800ms cubic-bezier(0.4, 0, 0.2, 1);
}

.card-3d.card-flipped {
  transform: rotateY(180deg);
}

/* 卡背 */
.card-back {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  background: 
    radial-gradient(ellipse at 50% 50%, rgba(196, 30, 30, 0.15) 0%, transparent 60%),
    linear-gradient(135deg, #2C1810 0%, #1A0F08 50%, #0D0703 100%);
  border-radius: 16rpx;
  box-shadow: 
    0 16rpx 48rpx rgba(0, 0, 0, 0.5),
    inset 0 1rpx 0 rgba(183, 132, 40, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.card-back-frame {
  position: absolute;
  inset: 16rpx;
  border: 2rpx solid rgba(183, 132, 40, 0.3);
  border-radius: 10rpx;
}

.card-back-frame-inner {
  position: absolute;
  inset: 24rpx;
  border: 1rpx solid rgba(183, 132, 40, 0.15);
  border-radius: 8rpx;
}

.card-back-emblem {
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(196, 30, 30, 0.2) 0%, transparent 70%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-back-emblem-text {
  font-size: 72rpx;
  color: rgba(183, 132, 40, 0.4);
  font-weight: 800;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  text-shadow: 0 0 20rpx rgba(183, 132, 40, 0.2);
}

.card-back-stars {
  position: absolute;
  inset: 0;
}

.card-star {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: rgba(183, 132, 40, 0.3);
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(183, 132, 40, 0.4);
}

.star-1 { top: 60rpx; left: 50rpx; animation: starTwinkle 2s ease-in-out infinite; }
.star-2 { top: 100rpx; right: 60rpx; animation: starTwinkle 2.5s ease-in-out 0.5s infinite; }
.star-3 { bottom: 80rpx; left: 80rpx; animation: starTwinkle 2s ease-in-out 1s infinite; }

@keyframes starTwinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.card-back-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(100deg, transparent 30%, rgba(183, 132, 40, 0.1) 50%, transparent 70%);
  animation: backShine 3s ease-in-out infinite;
}

@keyframes backShine {
  0%, 100% { left: -100%; }
  50% { left: 200%; }
}

/* ---- 卡面 ---- */
.card-front {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  transform: rotateY(180deg);
  background: 
    radial-gradient(ellipse at 50% 0%, rgba(196, 30, 30, 0.04) 0%, transparent 50%),
    linear-gradient(180deg, #FAF5EC 0%, #F5EBD8 40%, #EDE0C8 100%);
  border-radius: 16rpx;
  box-shadow: 
    0 20rpx 60rpx rgba(0, 0, 0, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* 卡面边框 */
.card-border {
  position: absolute;
  inset: 10rpx;
  border: 2rpx solid rgba(183, 132, 40, 0.25);
  border-radius: 10rpx;
  pointer-events: none;
}

/* 卡面光泽 */
.card-shine {
  position: absolute;
  top: 0;
  left: -60%;
  width: 40%;
  height: 100%;
  background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, 0.3) 50%, transparent 80%);
  transform: skewX(-20deg);
  animation: cardShine 4s ease-in-out 1s infinite;
  pointer-events: none;
}

@keyframes cardShine {
  0%, 100% { left: -60%; }
  50% { left: 160%; }
}

/* 卡面顶部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 0;
}

/* 稀有度标签 */
.card-rarity {
  font-size: 18rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  letter-spacing: 3rpx;
}

.rarity-legendary {
  background: linear-gradient(135deg, #B78428, #FFD700, #B78428);
  color: #2C1810;
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.4);
}

.rarity-epic {
  background: linear-gradient(135deg, #8B0000, #C41E1E, #8B0000);
  color: #F5EBD8;
  box-shadow: 0 0 8rpx rgba(196, 30, 30, 0.3);
}

.rarity-rare {
  background: linear-gradient(135deg, #2C5F7C, #3A7CA5, #2C5F7C);
  color: #F5EBD8;
}

.rarity-common {
  background: rgba(139, 115, 85, 0.15);
  color: #8B7355;
  border: 1rpx solid rgba(139, 115, 85, 0.2);
}

.card-number {
  font-size: 20rpx;
  color: rgba(139, 115, 85, 0.5);
  font-weight: 600;
  letter-spacing: 2rpx;
  font-family: Georgia, serif;
}

/* 卡面正文 */
.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  position: relative;
}

.card-quote-mark-top {
  font-size: 56rpx;
  color: rgba(196, 30, 30, 0.2);
  font-family: Georgia, 'Songti SC', serif;
  line-height: 1;
  margin-bottom: 12rpx;
  align-self: flex-start;
}

.card-quote-mark-bottom {
  font-size: 56rpx;
  color: rgba(196, 30, 30, 0.2);
  font-family: Georgia, 'Songti SC', serif;
  line-height: 1;
  margin-top: 12rpx;
  align-self: flex-end;
}

.card-quote-text {
  font-size: 36rpx;
  line-height: 1.78;
  font-weight: 600;
  color: #2C1810;
  text-align: center;
  font-family: 'Noto Serif CJK SC', 'Songti SC', 'PingFang SC', serif;
  letter-spacing: 2rpx;
}

/* 卡面底部 */
.card-footer {
  padding: 0 32rpx 28rpx;
}

.card-source-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.card-source-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(183, 132, 40, 0.4), transparent);
  max-width: 80rpx;
}

.card-source-text {
  font-size: 20rpx;
  color: #8B7355;
  font-weight: 500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.card-seal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-seal {
  width: 52rpx;
  height: 52rpx;
  background: rgba(196, 30, 30, 0.85);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-6deg);
  box-shadow: 0 2rpx 8rpx rgba(196, 30, 30, 0.3);
}

.card-seal-text {
  font-size: 18rpx;
  color: #F5EBD8;
  font-weight: 800;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  letter-spacing: 1rpx;
}

.card-author {
  font-size: 20rpx;
  color: rgba(139, 115, 85, 0.6);
  font-weight: 500;
  letter-spacing: 2rpx;
  font-style: italic;
}

/* ============ 加载骨架 ============ */
.skeleton-card {
  width: 560rpx;
  height: 720rpx;
  margin-top: 20rpx;
  background: rgba(44, 24, 16, 0.3);
  border-radius: 16rpx;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.skeleton-line {
  height: 36rpx;
  background: rgba(183, 132, 40, 0.08);
  border-radius: 6rpx;
  margin-bottom: 20rpx;
}

.skeleton-line.long { width: 100%; }
.skeleton-line.medium { width: 80%; }
.skeleton-line.short { width: 50%; }

.skeleton-source {
  width: 160rpx;
  height: 24rpx;
  background: rgba(183, 132, 40, 0.06);
  border-radius: 6rpx;
  margin-top: 24rpx;
  align-self: flex-end;
}

/* ============ 操作栏 ============ */
.action-bar {
  width: 690rpx;
  margin-top: 32rpx;
  padding: 14rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(44, 24, 16, 0.6);
  border: 1rpx solid rgba(183, 132, 40, 0.15);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(12rpx);
  transition: opacity 180ms ease;
  position: relative;
  z-index: 2;
}

.action-bar.is-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  min-height: 88rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  transition: transform 160ms ease, opacity 160ms ease;
}

.action-hover {
  transform: scale(0.92);
  opacity: 0.75;
}

.action-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  transform-origin: center;
}

.action-label {
  font-size: 20rpx;
  color: rgba(245, 235, 216, 0.55);
  line-height: 28rpx;
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.action-btn.like.active .action-label {
  color: #E83030;
}

.action-btn.favorite.active .action-label {
  color: #B78428;
}

/* ============ 动画 ============ */
@keyframes scalePop {
  0% { transform: scale(1); }
  45% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

.action-icon-wrap.animate-pop {
  animation: scalePop 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@media (prefers-reduced-motion: reduce) {
  .box-wrap,
  .card-3d,
  .card-stage,
  .action-btn,
  .box-hint-text,
  .hint-dot,
  .card-star,
  .card-back-shine,
  .card-shine,
  .particle,
  .light-beam,
  .box-glow,
  .action-icon-wrap.animate-pop {
    animation: none !important;
    transition: none !important;
  }
}
