/* ============ 全屏 aurora，避免操作栏区域露出 page 纯色白底 ============ */
.page-aurora {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  background: var(--aurora-bg);
}

/* ============ 容器：品牌 + 卡牌；底边贴 Tab，操作栏浮在其上 ============ */
/* 显式覆盖 app.wxss .container 的 min-height/padding */
.container {
  position: fixed;
  top: 88px;
  left: 0;
  right: 0;
  bottom: 90px;
  width: auto;
  height: auto;
  min-height: 0 !important;
  max-height: none;
  box-sizing: border-box;
  background: transparent;
  color: #2A1E18;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  z-index: 1;
}

/* ============ 背景粒子（暖金光尘，轻量化） ============ */
.bg-particles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #E0B25E;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 10rpx rgba(201, 148, 63, 0.55);
}

.particle-0 { left: 15%; top: 30%; animation: particleFloat 1.2s ease-out forwards; }
.particle-1 { left: 30%; top: 25%; animation: particleFloat 1.5s ease-out forwards; }
.particle-2 { left: 50%; top: 20%; animation: particleFloat 1.3s ease-out forwards; }
.particle-3 { left: 70%; top: 25%; animation: particleFloat 1.6s ease-out forwards; }
.particle-4 { left: 85%; top: 30%; animation: particleFloat 1.2s ease-out forwards; }
.particle-5 { left: 20%; top: 45%; animation: particleFloat 1.4s ease-out forwards; }
.particle-6 { left: 40%; top: 40%; animation: particleFloat 1.7s ease-out forwards; }
.particle-7 { left: 60%; top: 40%; animation: particleFloat 1.3s ease-out forwards; }
.particle-8 { left: 80%; top: 45%; animation: particleFloat 1.5s ease-out forwards; }
.particle-9 { left: 25%; top: 60%; animation: particleFloat 1.2s ease-out forwards; }
.particle-10 { left: 55%; top: 55%; animation: particleFloat 1.6s ease-out forwards; }
.particle-11 { left: 75%; top: 60%; animation: particleFloat 1.4s ease-out forwards; }

@keyframes particleFloat {
  0% { opacity: 0; transform: translateY(0) scale(0); }
  20% { opacity: 0.9; transform: translateY(-20rpx) scale(1); }
  100% { opacity: 0; transform: translateY(-120rpx) scale(0.3); }
}

/* ============ 品牌区 ============ */
.brand-area {
  flex-shrink: 0;
  padding-top: 12rpx;
  padding-bottom: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 6;
}

/* Logo（方案 C · 毛选印记）：玻璃 squircle + 红印章竖排「毛选」+ 金色落款点 */
.brand-stamp {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 8rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.54) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 10rpx 26rpx rgba(120, 90, 60, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.stamp-seal {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 52rpx;
  height: 52rpx;
  transform: translate(-50%, -50%);
  border-radius: 12rpx;
  background: linear-gradient(135deg, #D8483E 0%, #CF3A32 55%, #AD2822 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow:
    0 6rpx 14rpx rgba(138, 43, 36, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.05;
}

.stamp-char {
  font-size: 22rpx;
  font-weight: 800;
  color: #FFF9F4;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
}

.stamp-dot {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: linear-gradient(135deg, #D8AC5C 0%, #A5762C 100%);
  box-shadow: 0 0 6rpx rgba(201, 148, 63, 0.6);
}

.brand-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #241A15;
  letter-spacing: 10rpx;
  margin-bottom: 6rpx;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
}

.brand-divider {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.divider-line {
  width: 40rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #C9943F, transparent);
}

.divider-dot {
  width: 6rpx;
  height: 6rpx;
  background: #C9943F;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(201, 148, 63, 0.5);
}

.brand-slogan {
  font-size: 22rpx;
  color: #7A6A5C;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.daily-summary {
  margin-top: 8rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.daily-label,
.streak-label {
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #6E5F55;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
}

.daily-label {
  color: #AD2822;
}

/* 矮屏 / 揭卡后进一步压缩品牌区，把高度留给卡牌与操作栏 */
.container.is-compact .brand-stamp,
.container.is-revealed .brand-stamp {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 4rpx;
  border-radius: 14rpx;
}

.container.is-compact .stamp-seal,
.container.is-revealed .stamp-seal {
  width: 40rpx;
  height: 40rpx;
}

.container.is-compact .stamp-char,
.container.is-revealed .stamp-char {
  font-size: 18rpx;
}

.container.is-compact .brand-title,
.container.is-revealed .brand-title {
  font-size: 34rpx;
  letter-spacing: 8rpx;
  margin-bottom: 2rpx;
}

.container.is-compact .brand-slogan,
.container.is-revealed .brand-slogan {
  display: none;
}

.container.is-compact .brand-divider,
.container.is-revealed .brand-divider {
  display: none;
}

.container.is-compact .daily-summary,
.container.is-revealed .daily-summary {
  margin-top: 4rpx;
  min-height: 40rpx;
}

/* ============ 礼盒区 ============ */
.box-area {
  width: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  padding-top: 12rpx;
}

.box-area.state-opening,
.box-area.state-revealed {
  padding-top: 0;
  justify-content: flex-start;
}

/* ---- 中国风锦盒（天地盖 · 描金 · 方印） ---- */
.box-wrap {
  width: 280rpx;
  height: 280rpx;
  position: relative;
  transition: transform 200ms ease, opacity 360ms ease;
}

.container.is-compact .box-wrap {
  width: 240rpx;
  height: 240rpx;
}

.box-area.state-opening .box-wrap,
.box-area.state-revealed .box-wrap {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 280rpx;
  height: 280rpx;
  margin-left: -140rpx;
  transform: translateY(-20rpx) scale(0.45);
  opacity: 0.22;
  pointer-events: none;
  transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1), opacity 360ms ease;
}

.container.is-compact .box-area.state-opening .box-wrap,
.container.is-compact .box-area.state-revealed .box-wrap {
  width: 240rpx;
  height: 240rpx;
  margin-left: -120rpx;
}

.box-pressed {
  transform: scale(0.97);
}

.box-wrap.is-shaking {
  animation: boxShake 500ms ease-in-out;
}

@keyframes boxShake {
  0%, 100% { transform: rotate(0) translateX(0); }
  15% { transform: rotate(-3deg) translateX(-6rpx); }
  30% { transform: rotate(3deg) translateX(6rpx); }
  45% { transform: rotate(-2deg) translateX(-4rpx); }
  60% { transform: rotate(2deg) translateX(4rpx); }
  75% { transform: rotate(-1deg) translateX(-2rpx); }
  90% { transform: rotate(1deg) translateX(1rpx); }
}

/* 天盖 */
.box-lid {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 86%;
  height: 32%;
  z-index: 6;
  transition: transform 800ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 600ms ease 400ms;
}

.lid-face {
  position: absolute;
  inset: 0;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(165deg, #E2554C 0%, #CF3A32 42%, #AD2822 100%);
  border: 2rpx solid rgba(216, 172, 92, 0.85);
  box-shadow:
    0 12rpx 28rpx rgba(120, 40, 30, 0.28),
    inset 0 2rpx 0 rgba(255, 220, 180, 0.35),
    inset 0 -2rpx 0 rgba(100, 20, 16, 0.25);
  overflow: hidden;
}

.gold-frame {
  position: absolute;
  inset: 10rpx;
  border: 1rpx solid rgba(232, 196, 120, 0.55);
  border-radius: 4rpx;
  pointer-events: none;
}

/* 四角回纹简笔 */
.corner {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-color: rgba(232, 196, 120, 0.75);
  border-style: solid;
  pointer-events: none;
}

.corner-tl {
  top: 16rpx;
  left: 16rpx;
  border-width: 2rpx 0 0 2rpx;
}

.corner-tr {
  top: 16rpx;
  right: 16rpx;
  border-width: 2rpx 2rpx 0 0;
}

.corner-bl {
  bottom: 16rpx;
  left: 16rpx;
  border-width: 0 0 2rpx 2rpx;
}

.corner-br {
  bottom: 16rpx;
  right: 16rpx;
  border-width: 0 2rpx 2rpx 0;
}

/* 盖面方印 */
.lid-seal {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  background: linear-gradient(145deg, #FFF8F0 0%, #F3E2C8 100%);
  border: 2rpx solid rgba(173, 40, 34, 0.9);
  box-shadow:
    0 4rpx 10rpx rgba(80, 20, 16, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.lid-seal-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #AD2822;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  line-height: 1;
}

.box-lid.lid-fly {
  animation: lidPop 800ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes lidPop {
  0% { transform: translateX(-50%) translateY(0) rotate(0deg); opacity: 1; }
  35% { transform: translateX(-50%) translateY(-72rpx) rotate(-6deg); opacity: 1; }
  100% { transform: translateX(-50%) translateY(-200rpx) rotate(-18deg); opacity: 0; }
}

/* 地盒 */
.box-body {
  position: absolute;
  top: 28%;
  left: 50%;
  transform: translateX(-50%);
  width: 88%;
  height: 67%;
  z-index: 3;
}

.box-face {
  position: absolute;
  inset: 0;
  border-radius: 4rpx 4rpx 16rpx 16rpx;
  background:
    radial-gradient(ellipse at 50% 20%, rgba(207, 58, 50, 0.08), transparent 55%),
    linear-gradient(180deg, #FBF4EC 0%, #F0E2D4 55%, #E8D5C2 100%);
  border: 2rpx solid rgba(201, 148, 63, 0.55);
  box-shadow:
    0 18rpx 40rpx rgba(120, 70, 40, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.body-frame {
  inset: 14rpx;
  border-color: rgba(201, 148, 63, 0.35);
}

.body-motif {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.motif-line {
  width: 36rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(173, 40, 34, 0.45), transparent);
}

.motif-char {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: rgba(173, 40, 34, 0.55);
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
}

/* 开盒柔光 */
.box-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255, 220, 170, 0.55) 0%, rgba(201, 148, 63, 0.2) 45%, transparent 72%);
  border-radius: 50%;
  animation: glowPulse 600ms ease-out;
  pointer-events: none;
}

@keyframes glowPulse {
  0% { transform: translate(-50%, -50%) scale(0.4); opacity: 0; }
  40% { opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1.8); opacity: 0; }
}

/* 待拆提示 */
.box-hint {
  position: absolute;
  bottom: -44rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  z-index: 5;
}

.box-hint-text {
  font-size: 24rpx;
  color: #6E5F55;
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* ============ 开盒柔光柱 ============ */
.light-beam {
  position: absolute;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 140rpx;
  height: 320rpx;
  background: linear-gradient(180deg,
    rgba(255, 220, 170, 0.28) 0%,
    rgba(201, 148, 63, 0.1) 40%,
    transparent 100%);
  clip-path: polygon(42% 0%, 58% 0%, 88% 100%, 12% 100%);
  z-index: 3;
  animation: beamGrow 600ms ease-out;
  pointer-events: none;
}

.light-beam.beam-fade {
  animation: beamFade 800ms ease-out forwards;
}

@keyframes beamGrow {
  0% { opacity: 0; transform: translateX(-50%) scaleY(0); transform-origin: top; }
  100% { opacity: 1; transform: translateX(-50%) scaleY(1); transform-origin: top; }
}

@keyframes beamFade {
  0% { opacity: 1; }
  100% { opacity: 0; }
}

/* ============ 卡牌舞台 ============ */
.card-stage {
  width: 100%;
  display: flex;
  justify-content: center;
  position: relative;
  z-index: 4;
  margin-top: 20rpx;
  perspective: 1500rpx;
}

.box-area.state-opening .card-stage,
.box-area.state-revealed .card-stage {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  margin-top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 舞台内垂直居中，底部多留空形成「居中偏上」，避免顶到品牌区 */
  justify-content: center;
  padding-top: 0;
  padding-bottom: 56rpx;
  box-sizing: border-box;
}

.card-stage.card-rising {
  animation: cardRise 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.card-stage.card-up {
  animation: cardFloat 3s ease-in-out 700ms infinite;
}

@keyframes cardRise {
  0% { opacity: 0; transform: translateY(80rpx) scale(0.6); }
  60% { opacity: 1; transform: translateY(-6rpx) scale(1.03); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes cardFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* 3D 翻转容器 */
.card-3d {
  width: 540rpx;
  height: 680rpx;
  max-width: 86vw;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 800ms cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

.card-3d.card-flipped {
  transform: rotateY(180deg);
}

/* 卡背（玻璃 + 红色透光） */
.card-back {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  background:
    radial-gradient(ellipse at 50% 40%, rgba(207, 58, 50, 0.3) 0%, transparent 62%),
    linear-gradient(135deg, rgba(255, 250, 246, 0.9) 0%, rgba(250, 234, 224, 0.78) 50%, rgba(245, 226, 212, 0.85) 100%);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow:
    0 24rpx 70rpx rgba(120, 90, 60, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.card-back-frame {
  position: absolute;
  inset: 20rpx;
  border: 2rpx solid rgba(201, 148, 63, 0.5);
  border-radius: 20rpx;
}

.card-back-frame-inner {
  position: absolute;
  inset: 32rpx;
  border: 1rpx solid rgba(201, 148, 63, 0.3);
  border-radius: 16rpx;
}

.card-back-emblem {
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(207, 58, 50, 0.22) 0%, transparent 70%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-back-emblem-text {
  font-size: 72rpx;
  color: rgba(190, 70, 60, 0.55);
  font-weight: 800;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  text-shadow: 0 0 20rpx rgba(207, 58, 50, 0.18);
}

.card-back-stars {
  position: absolute;
  inset: 0;
}

.card-star {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: rgba(201, 148, 63, 0.5);
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(201, 148, 63, 0.45);
}

.star-1 { top: 60rpx; left: 50rpx; animation: starTwinkle 2s ease-in-out infinite; }
.star-2 { top: 100rpx; right: 60rpx; animation: starTwinkle 2.5s ease-in-out 0.5s infinite; }
.star-3 { bottom: 80rpx; left: 80rpx; animation: starTwinkle 2s ease-in-out 1s infinite; }

@keyframes starTwinkle {
  0%, 100% { opacity: 0.25; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.card-back-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.5) 50%, transparent 70%);
  animation: backShine 3s ease-in-out infinite;
}

@keyframes backShine {
  0%, 100% { left: -100%; }
  50% { left: 200%; }
}

/* ---- 卡面（磨砂玻璃卡片） ---- */
.card-front {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  transform: rotateY(180deg);
  background:
    radial-gradient(ellipse at 50% 0%, rgba(207, 58, 50, 0.06) 0%, transparent 50%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 248, 240, 0.84) 46%, rgba(250, 240, 230, 0.9) 100%);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 28rpx 80rpx rgba(120, 90, 60, 0.32),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* 卡面边框 */
.card-border {
  position: absolute;
  inset: 14rpx;
  border: 2rpx solid rgba(201, 148, 63, 0.4);
  border-radius: 20rpx;
  pointer-events: none;
}

/* 卡面光泽 */
.card-shine {
  position: absolute;
  top: 0;
  left: -60%;
  width: 40%;
  height: 100%;
  background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, 0.5) 50%, transparent 80%);
  transform: skewX(-20deg);
  animation: cardShine 4s ease-in-out 1s infinite;
  pointer-events: none;
}

@keyframes cardShine {
  0%, 100% { left: -60%; }
  50% { left: 160%; }
}

/* 卡面顶部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx 0;
}

/* 稀有度标签 */
.card-rarity {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  letter-spacing: 3rpx;
}

.rarity-legendary {
  background: linear-gradient(135deg, #D8AC4E, #F1CE6E, #C9943F);
  color: #3A2A12;
  box-shadow: 0 4rpx 14rpx rgba(201, 148, 63, 0.38);
}

.rarity-epic {
  background: linear-gradient(135deg, #AD2822, #D8483E, #AD2822);
  color: #FFF9F4;
  box-shadow: 0 4rpx 12rpx rgba(207, 58, 50, 0.34);
}

.rarity-rare {
  background: linear-gradient(135deg, #3D7394, #5B91B4, #3D7394);
  color: #F3FAFF;
}

.rarity-common {
  background: rgba(140, 118, 96, 0.14);
  color: #6E5F55;
  border: 1rpx solid rgba(140, 118, 96, 0.22);
}

.card-number {
  font-size: 22rpx;
  color: #7A6A5C;
  font-weight: 600;
  letter-spacing: 2rpx;
  font-family: Georgia, serif;
}

/* 卡面正文 */
.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  position: relative;
  min-height: 0;
}

.card-quote-mark-top {
  font-size: 44rpx;
  color: rgba(207, 58, 50, 0.3);
  font-family: Georgia, 'Songti SC', serif;
  line-height: 1;
  margin-bottom: 6rpx;
  align-self: flex-start;
}

.card-quote-mark-bottom {
  font-size: 44rpx;
  color: rgba(207, 58, 50, 0.3);
  font-family: Georgia, 'Songti SC', serif;
  line-height: 1;
  margin-top: 6rpx;
  align-self: flex-end;
}

.card-quote-text {
  font-size: 32rpx;
  line-height: 1.55;
  font-weight: 600;
  color: #241A15;
  text-align: center;
  font-family: 'Noto Serif CJK SC', 'Songti SC', 'PingFang SC', serif;
  letter-spacing: 1rpx;
}

.container.is-compact .card-quote-text {
  font-size: 30rpx;
  line-height: 1.5;
}

/* 卡面底部 */
.card-footer {
  padding: 0 28rpx 22rpx;
}

.card-source-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.container.is-compact .card-source-row {
  margin-bottom: 8rpx;
}

.container.is-compact .card-footer {
  padding: 0 24rpx 16rpx;
}

.card-source-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 148, 63, 0.6), transparent);
  max-width: 80rpx;
}

.card-source-text {
  font-size: 22rpx;
  color: #6E5F55;
  font-weight: 600;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.card-seal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-seal {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #D8483E, #AD2822);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-6deg);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(207, 58, 50, 0.32);
}

.card-seal-text {
  font-size: 22rpx;
  color: #FFF9F4;
  font-weight: 800;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  letter-spacing: 1rpx;
}

.card-author {
  font-size: 22rpx;
  color: #7A6A5C;
  font-weight: 500;
  letter-spacing: 2rpx;
  font-style: italic;
}

/* ============ 加载骨架 ============ */
.skeleton-card {
  width: 540rpx;
  height: 680rpx;
  margin-top: 12rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.34) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.skeleton-line {
  height: 36rpx;
  background: rgba(160, 130, 105, 0.16);
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.skeleton-line.long { width: 100%; }
.skeleton-line.medium { width: 80%; }
.skeleton-line.short { width: 50%; }

.skeleton-source {
  width: 160rpx;
  height: 24rpx;
  background: rgba(160, 130, 105, 0.12);
  border-radius: 8rpx;
  margin-top: 24rpx;
  align-self: flex-end;
}

/* ============ 操作栏：独立 fixed，永远在自定义 Tab 上方 ============ */
.action-bar {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 96px;
  z-index: 15;
  width: 690rpx;
  box-sizing: border-box;
  padding: 6rpx 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* 轻透玻璃，透出下方 aurora，避免实心白条 */
  background: rgba(255, 248, 240, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 36rpx;
  box-shadow:
    0 8rpx 24rpx rgba(120, 90, 60, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20rpx) saturate(140%);
  -webkit-backdrop-filter: blur(20rpx) saturate(140%);
  transition: opacity 180ms ease;
}

.action-bar.is-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 4rpx 2rpx;
  border-radius: 28rpx;
  transition: transform 160ms ease, opacity 160ms ease, background-color 160ms ease;
}

.action-bar.is-compact .action-btn {
  min-height: 68rpx;
}

.action-bar.is-compact .action-label {
  font-size: 20rpx;
  line-height: 26rpx;
}

button.share-btn {
  margin: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button.share-btn::after {
  border: none;
}

.action-hover {
  transform: scale(0.9);
  opacity: 0.72;
  background: rgba(207, 58, 50, 0.06);
}

.action-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  transform-origin: center;
}

.action-label {
  font-size: 24rpx;
  color: #6E5F55;
  line-height: 32rpx;
  white-space: nowrap;
  letter-spacing: 1rpx;
  font-weight: 500;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-btn.like.active .action-label {
  color: #CF3A32;
  font-weight: 700;
}

.action-btn.favorite.active .action-label {
  color: #8C6A1F;
  font-weight: 700;
}

/* ============ 动画 ============ */
@keyframes scalePop {
  0% { transform: scale(1); }
  45% { transform: scale(1.24); }
  100% { transform: scale(1); }
}

.action-icon-wrap.animate-pop {
  animation: scalePop 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@media (prefers-reduced-motion: reduce) {
  .box-wrap,
  .card-3d,
  .card-stage,
  .action-btn,
  .box-hint-text,
  .card-star,
  .card-back-shine,
  .card-shine,
  .particle,
  .light-beam,
  .box-glow,
  .action-icon-wrap.animate-pop {
    animation: none !important;
    transition: none !important;
  }
}