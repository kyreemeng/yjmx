.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-area {
  padding-top: 80rpx;
  padding-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #C41E1E;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
}

.brand-slogan {
  font-size: 26rpx;
  color: #8B7355;
  letter-spacing: 2rpx;
}

.skeleton-card {
  width: 690rpx;
  min-height: 480rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 60rpx 48rpx;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(44, 24, 16, 0.06);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.skeleton-line {
  height: 40rpx;
  background: #F0EDE8;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.skeleton-line.long {
  width: 100%;
}

.skeleton-line.medium {
  width: 80%;
}

.skeleton-line.short {
  width: 60%;
}

.skeleton-source {
  width: 160rpx;
  height: 28rpx;
  background: #F0EDE8;
  border-radius: 8rpx;
  margin-top: 24rpx;
  align-self: flex-end;
}
