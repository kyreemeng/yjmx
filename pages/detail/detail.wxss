.container {
  min-height: 100vh;
  background: var(--aurora-bg);
  color: #2A1E18;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-header {
  padding: 36rpx 0 20rpx;
}

.detail-from {
  font-size: 24rpx;
  color: #6E5F55;
  letter-spacing: 0;
}

.detail-loading {
  min-height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6E5F55;
  font-size: 26rpx;
}
