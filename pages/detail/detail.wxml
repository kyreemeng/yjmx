<view class="container">
  <view class="detail-header">
    <text class="detail-from">来自「{{from}}」</text>
  </view>

  <quote-card
    wx:if="{{quote}}"
    quote="{{quote}}"
    liked="{{liked}}"
    favorited="{{favorited}}"
    showRefresh="{{false}}"
    bind:like="onLike"
    bind:favorite="onFavorite"
    bind:share="onShare"
  ></quote-card>

  <login-modal
    show="{{showLoginModal}}"
    bind:success="onLoginSuccess"
    bind:fail="onLoginFail"
    bind:close="onCloseLoginModal"
  ></login-modal>

  <share-poster
    wx:if="{{showSharePoster}}"
    visible="{{showSharePoster}}"
    quote="{{quote}}"
    bind:close="onCloseSharePoster"
    bind:share="onPosterShare"
  ></share-poster>
</view>
