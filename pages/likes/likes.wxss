.container {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% -10%, rgba(196, 30, 30, 0.13), transparent 42%),
    linear-gradient(165deg, #1A0F08 0%, #2C1810 55%, #0D0703 100%);
  padding: 42rpx 0 calc(60rpx + env(safe-area-inset-bottom));
}

.page-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 0 42rpx 32rpx;
}

.hero-seal {
  width: 74rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(245, 235, 216, 0.72);
  border-radius: 8rpx;
  background: linear-gradient(135deg, #C41E1E, #7E1111);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  transform: rotate(-4deg);
}

.hero-seal text {
  color: #F5EBD8;
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
}

.page-title,
.page-subtitle {
  display: block;
}

.page-title {
  color: #F5EBD8;
  font-size: 38rpx;
  line-height: 1.25;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.page-subtitle {
  margin-top: 8rpx;
  color: rgba(245, 235, 216, 0.54);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.skeleton-list {
  padding: 0 32rpx;
}

.skeleton-item {
  background: rgba(245, 235, 216, 0.08);
  border: 1rpx solid rgba(183, 132, 40, 0.16);
  border-radius: 12rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.skeleton-text {
  width: 100%;
  height: 36rpx;
  background: rgba(245, 235, 216, 0.12);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-sub {
  width: 40%;
  height: 24rpx;
  background: rgba(245, 235, 216, 0.08);
  border-radius: 8rpx;
}

.list {
  padding: 0 32rpx;
}

.list-item {
  background:
    linear-gradient(135deg, rgba(245, 235, 216, 0.98), rgba(234, 220, 195, 0.98));
  border: 1rpx solid rgba(183, 132, 40, 0.38);
  border-radius: 12rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.25), inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  transition: transform 160ms ease, background-color 160ms ease;
}

.item-quote {
  font-size: 32rpx;
  color: #2A170E;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  line-height: 1.6;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-source {
  font-size: 24rpx;
  color: #7A5139;
  max-width: 72%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  font-size: 24rpx;
  color: #856A56;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(122, 81, 57, 0.16);
}

.item-action {
  flex: 1;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1rpx solid rgba(122, 81, 57, 0.24);
  border-radius: 10rpx;
  color: #7A5139;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.42);
  transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
}

.item-action.active {
  background: rgba(183, 132, 40, 0.1);
  border-color: rgba(183, 132, 40, 0.52);
}

.item-action.like-action.active {
  background: rgba(196, 30, 30, 0.08);
  border-color: rgba(196, 30, 30, 0.4);
  color: #A01818;
}

.item-action.favorite-action.active {
  color: #8A6010;
}

.item-action-pressed {
  transform: scale(0.97);
  background: rgba(122, 81, 57, 0.12);
}

@media (prefers-reduced-motion: reduce) {
  .list-item,
  .item-action {
    transition: none;
  }
}
