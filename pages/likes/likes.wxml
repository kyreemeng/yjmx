<view class="container">
  <view class="page-hero">
    <view class="hero-seal"><text>赞</text></view>
    <view>
      <text class="page-title">点赞记录</text>
      <text class="page-subtitle">轻触下方图标，管理点赞与收藏</text>
    </view>
  </view>

  <view wx:if="{{loading && list.length === 0}}" class="skeleton-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-item">
      <view class="skeleton-text"></view>
      <view class="skeleton-sub"></view>
    </view>
  </view>

  <view wx:if="{{list.length > 0}}" class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="list-item"
      data-id="{{item.id}}"
      bindtap="onItemTap"
    >
      <text class="item-quote">{{item.summary}}</text>
      <view class="item-meta">
        <text class="item-source">{{item.source}}</text>
        <text class="item-time">{{item.timeText}}</text>
      </view>
      <view class="item-actions">
        <view
          class="item-action like-action active"
          data-id="{{item.id}}"
          catchtap="onLike"
          hover-class="item-action-pressed"
        >
          <app-icon name="heart" color="#C41E1E" size="{{30}}" filled="{{true}}"></app-icon>
          <text>已点赞</text>
        </view>
        <view
          class="item-action favorite-action {{item.favorited ? 'active' : ''}}"
          data-id="{{item.id}}"
          catchtap="onFavorite"
          hover-class="item-action-pressed"
        >
          <app-icon
            name="star"
            color="{{item.favorited ? '#B78428' : '#7A5139'}}"
            size="{{30}}"
            filled="{{item.favorited}}"
          ></app-icon>
          <text>{{item.favorited ? '已收藏' : '收藏'}}</text>
        </view>
      </view>
    </view>
  </view>

  <empty-state
    wx:if="{{!loading && list.length === 0}}"
    type="like"
    bind:action="onGoHome"
  ></empty-state>
</view>
