.container {
  min-height: 100vh;
  background: var(--aurora-bg);
  color: #2A1E18;
  padding: 28rpx 0 calc(150rpx + env(safe-area-inset-bottom));
}

.profile-panel {
  position: relative;
  margin: 0 32rpx;
  padding: 40rpx 32rpx 32rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 18% 12%, rgba(207, 58, 50, 0.12), transparent 34%),
    radial-gradient(circle at 88% 88%, rgba(201, 148, 63, 0.1), transparent 40%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.84) 0%, rgba(255, 255, 255, 0.66) 100%);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
  box-shadow:
    0 12rpx 36rpx rgba(120, 90, 60, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.panel-stamp {
  position: absolute;
  top: 22rpx;
  right: 28rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.54) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 6rpx 14rpx rgba(120, 90, 60, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.panel-stamp .seal-inner {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 50rpx;
  height: 50rpx;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #D8483E 0%, #CF3A32 55%, #AD2822 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow:
    0 4rpx 10rpx rgba(138, 43, 36, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.panel-stamp .seal-dot {
  position: absolute;
  right: 7rpx;
  bottom: 7rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: linear-gradient(135deg, #D8AC5C 0%, #A5762C 100%);
}

.panel-stamp text {
  font-size: 26rpx;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  font-weight: 700;
  color: #FFF9F4;
}

.user-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 12rpx;
}

.user-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #EDDFD2;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(120, 90, 60, 0.14);
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #241A15;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  margin-bottom: 6rpx;
  letter-spacing: -0.3rpx;
}

.user-tip {
  font-size: 26rpx;
  color: #6E5F55;
}

.login-area {
  padding: 12rpx 0 0;
}

.login-btn {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  line-height: normal;
  color: #FFF9F4;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  background: linear-gradient(135deg, #D8483E, #AD2822);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(207, 58, 50, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.97);
  opacity: 0.94;
  transition: transform 100ms ease-out;
}

.reading-summary {
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 10rpx 28rpx rgba(120, 90, 60, 0.1);
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-title,
.summary-streak {
  display: block;
}

.summary-title {
  font-size: 30rpx;
  color: #241A15;
  font-weight: 700;
}

.summary-streak,
.summary-count {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6E5F55;
}

.summary-percent {
  font-size: 36rpx;
  color: #AD2822;
  font-weight: 700;
}

.rarity-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.rarity-stat {
  min-height: 88rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 16rpx;
  background: rgba(140, 118, 96, 0.07);
}

.rarity-name,
.rarity-count,
.summary-retry {
  font-size: 24rpx;
}

.rarity-name {
  color: #5F5148;
}

.rarity-count {
  color: #241A15;
  font-weight: 700;
}

.summary-retry {
  min-height: 88rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #AD2822;
}

.menu-list {
  margin: 24rpx 32rpx 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.68) 100%);
  backdrop-filter: blur(26rpx) saturate(170%);
  -webkit-backdrop-filter: blur(26rpx) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(120, 90, 60, 0.1), inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 108rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(140, 118, 96, 0.1);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-label {
  font-size: 30rpx;
  color: #241A15;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-count {
  font-size: 28rpx;
  color: #6E5F55;
  margin-right: 8rpx;
  font-variant-numeric: tabular-nums;
}

.menu-item-pressed {
  background: rgba(140, 118, 96, 0.06);
}

.logout-area {
  margin-top: 32rpx;
  padding: 0 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  color: #CF3A32;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: rgba(207, 58, 50, 0.08);
  transform: scale(0.98);
}
