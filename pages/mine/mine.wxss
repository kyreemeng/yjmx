.container {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% -10%, rgba(196, 30, 30, 0.14), transparent 40%),
    linear-gradient(165deg, #1A0F08 0%, #2C1810 55%, #0D0703 100%);
  padding: 42rpx 0 calc(140rpx + env(safe-area-inset-bottom));
}

.profile-panel {
  position: relative;
  margin: 0 32rpx;
  padding: 42rpx 32rpx 34rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 15% 15%, rgba(196, 30, 30, 0.25), transparent 26%),
    linear-gradient(135deg, rgba(75, 38, 25, 0.96), rgba(31, 15, 8, 0.98));
  border: 1rpx solid rgba(183, 132, 40, 0.32);
  border-radius: 14rpx;
  box-shadow: 0 14rpx 42rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(245, 235, 216, 0.12);
}

.panel-stamp {
  position: absolute;
  top: 24rpx;
  right: 30rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(245, 235, 216, 0.5);
  border-radius: 7rpx;
  color: rgba(245, 235, 216, 0.82);
  background: rgba(196, 30, 30, 0.72);
  transform: rotate(7deg);
}

.panel-stamp text {
  font-size: 30rpx;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  font-weight: 700;
}

.user-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 18rpx;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #EDE0C8;
  margin-bottom: 24rpx;
  border: 5rpx solid rgba(245, 235, 216, 0.9);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.28);
}

.user-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #F5EBD8;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  margin-bottom: 8rpx;
}

.user-tip {
  font-size: 26rpx;
  color: rgba(245, 235, 216, 0.58);
}

.login-area {
  padding: 12rpx 0 0;
}

.login-btn {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  line-height: normal;
  color: #F5EBD8;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #C41E1E, #8D1414);
  border: 1rpx solid rgba(245, 235, 216, 0.34);
  border-radius: 10rpx;
  box-shadow: 0 7rpx 16rpx rgba(0, 0, 0, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}

.menu-list {
  margin: 26rpx 32rpx 0;
  background: linear-gradient(135deg, rgba(245, 235, 216, 0.98), rgba(234, 220, 195, 0.98));
  border: 1rpx solid rgba(183, 132, 40, 0.38);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(122, 81, 57, 0.12);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-label {
  font-size: 30rpx;
  color: #2A170E;
  font-family: 'Noto Serif CJK SC', 'Songti SC', serif;
  font-weight: 600;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-count {
  font-size: 28rpx;
  color: #856A56;
  margin-right: 12rpx;
}

.menu-item-pressed {
  background: #F5EBD8;
  transform: translateY(2rpx) scale(0.99);
}

.logout-area {
  margin-top: 36rpx;
  padding: 0 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  background: rgba(245, 235, 216, 0.08);
  color: rgba(245, 235, 216, 0.8);
  border: 1rpx solid rgba(245, 235, 216, 0.32);
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: rgba(196, 30, 30, 0.25);
  transform: translateY(2rpx);
}
